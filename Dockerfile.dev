# ---- Build Stage ----
FROM node:22.12.0 AS builder

WORKDIR /app

# Copy package configurations and install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy the rest of the application
COPY . .

# Build the Angular application using the development configuration.
# This ensures that relative paths like url_api: '/api' are baked natively into the static output.
RUN npm run build -- --configuration=production

# ---- Serve Stage ----
FROM nginx:alpine

# Configure Nginx to listen on port 4200 and handle SPA routing. The identity alias routes (/favicon.ico and the link-share image answered from the backend, static default as the fallback)
# are OFF unless the container is started with WS_IDENTITY_UPSTREAM (+ WS_IDENTITY_HOST, WS_RESOLVER); nothing about dev is baked into the image.
COPY nginx/dev.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/identity.inc.template /etc/nginx/identity.inc.template
COPY nginx/15-ws-identity.sh /docker-entrypoint.d/15-ws-identity.sh
RUN chmod +x /docker-entrypoint.d/15-ws-identity.sh

# Clean the default Nginx html directory
RUN rm -rf /usr/share/nginx/html/*

# Copy the compiled static assets from the Angular build.
# For Angular 17+ Application Builder, the browser output is placed in dist/[project-name]/browser
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

# Rename index.csr.html to index.html for static serving (Angular 17+ SSR outputs this)
RUN if [ -f /usr/share/nginx/html/index.csr.html ]; then mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; fi

# Ensure NGINX can read the files
RUN chmod -R 755 /usr/share/nginx/html

EXPOSE 4200

# Start Nginx server
CMD ["nginx", "-g", "daemon off;"]
