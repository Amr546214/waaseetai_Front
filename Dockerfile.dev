# ---- Build Stage ----
FROM node:22.12.0 AS builder

WORKDIR /app

# Copy package configurations and install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy the rest of the application
COPY . .

# Build the Angular application using the development configuration.
# This ensures that relative paths like url_api: '/api' are baked natively into the static output.
RUN npm run build -- --configuration=production

# ---- Serve Stage ----
FROM nginx:alpine

# Configure Nginx to listen on port 4200 and handle SPA routing
RUN echo 'server { \
    listen 4200; \
    server_name localhost; \
    include /etc/nginx/mime.types; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    location ~ \.(js|css|svg|ico|png|jpg|jpeg|woff|woff2|ttf|map)$ { \
        root /usr/share/nginx/html; \
        include /etc/nginx/mime.types; \
        try_files $uri =404; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Clean the default Nginx html directory
RUN rm -rf /usr/share/nginx/html/*

# Copy the compiled static assets from the Angular build.
# For Angular 17+ Application Builder, the browser output is placed in dist/[project-name]/browser
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

# Rename index.csr.html to index.html for static serving (Angular 17+ SSR outputs this)
RUN if [ -f /usr/share/nginx/html/index.csr.html ]; then mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; fi

# Ensure NGINX can read the files
RUN chmod -R 755 /usr/share/nginx/html

EXPOSE 4200

# Start Nginx server
CMD ["nginx", "-g", "daemon off;"]
